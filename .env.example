# =============================================================================
# Ads Dashboard — Environment Variables Template
# =============================================================================
#
# HOW TO USE THIS FILE:
#   1. Copy it to a new file called .env
#        Mac / Linux:  cp .env.example .env
#        Windows:      copy .env.example .env
#   2. Open .env and replace the placeholder values with your real credentials.
#   3. Never commit .env to Git — it's already listed in .gitignore.
#
# This file (.env.example) is safe to commit. It contains no real secrets.
# =============================================================================


# -----------------------------------------------------------------------------
# Meta (Facebook) Ads API
# -----------------------------------------------------------------------------
# These two variables let the app talk to your Meta Ads account.
# See the README for step-by-step instructions on where to find each value.

# A secret token that proves your app has permission to read your ad data.
META_ACCESS_TOKEN=your_meta_access_token_here

# The numeric ID of your Meta Ads account (digits only, no "act_" prefix).
META_AD_ACCOUNT_ID=your_ad_account_id_here
