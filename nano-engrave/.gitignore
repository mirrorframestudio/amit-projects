# נגזרות — נוצרות מהקוד ומהמקורות, ולכן אינן נשמרות.
#
# בלי זה התיקייה שוקלת 41MB, ורובם קבצים שאפשר לייצר מחדש בהרצה אחת.
# מה שנשמר הוא מה שאי אפשר לשחזר: המקורות, הקוד, והמפרטים שנשלחו למפעל.

# פלט הרינדור וההמרות — 20MB של PNG, PDF, DOCX ו-JSON
out/

# חבילות שנארזות למשלוח, ונבנות מחדש מהתיקיות עצמן
library_texts.zip
launch_five.zip

# אינדקס הספרייה — נבנה ע"י build_library.py מתוך אותם טקסטים
library/catalog.json

# העימודים של הספרייה. הטקסט עצמו (.txt) ומפרט הצריבה (spec.txt)
# כן נשמרים — הם הקלט של המפעל ומה שמאמתים מולו
library/**/*.pdf
library/**/*.docx

__pycache__/
*.pyc

# פונטים של מיקרוסופט — אינם ניתנים להפצה מחדש, ואינם בשימוש:
# הצינור עומד על NotoSerifHebrew, ו-build_docx מבקש "David" בשם בלבד
# (שם פונט ב-Word), ולא את קובץ ה-TTF.
assets/arial-*.ttf
assets/times-*.ttf
assets/david-*.ttf

# מופעים סטטיים שנוצרים ע"י shaper.py מתוך הפונט המשתנה
assets/*-w[0-9]*-wd[0-9]*.ttf
