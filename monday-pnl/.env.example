# Monday.com API
MONDAY_API_TOKEN=your_monday_api_token_here
MONDAY_BOARD_ID=your_board_id_here

# P&L Parameters
VAT_RATE=0.18
PAYMENT_FEE_RATE=0.014
PAYMENT_FEE_FIXED=0
DEFAULT_AD_COST=0
COGS_PICKUP=5.70
COGS_HOME=10.20
SHIP_COST_PICKUP=0
SHIP_COST_HOME=0

# MODE: INCLUDES_VAT or EXCLUDES_VAT
MODE=INCLUDES_VAT

# CURRENCY: USD or ILS
CURRENCY=USD

# Output
OUTPUT_FILE=P&L.xlsx

# Schedule (cron expression, default 09:00 Asia/Jerusalem)
SCHEDULE_CRON=0 9 * * *
SCHEDULE_TZ=Asia/Jerusalem

# Logging
LOG_LEVEL=INFO
