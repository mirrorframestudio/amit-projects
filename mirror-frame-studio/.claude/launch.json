{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mirror-frame-studio",
      "runtimeExecutable": "node",
      "runtimeArgs": ["-e", "const {createServer}=require('http'),fs=require('fs'),path=require('path');const port=process.env.PORT||3457;createServer((req,res)=>{let f=path.join('.',req.url==='/'?'/index.html':req.url);fs.readFile(f,(e,d)=>{if(e){res.writeHead(404);res.end('Not found');}else{const ext=path.extname(f);const t={'html':'text/html','css':'text/css','js':'application/javascript','jpg':'image/jpeg','png':'image/png','mp4':'video/mp4'}[ext.slice(1)]||'application/octet-stream';res.writeHead(200,{'Content-Type':t});res.end(d);}});}).listen(port,()=>console.log('Server on '+port));"],
      "port": 3457,
      "autoPort": true
    }
  ]
}
