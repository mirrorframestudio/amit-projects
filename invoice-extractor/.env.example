# מפתח API של Anthropic (Claude)
# קבל בחינם על: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# סינון אופציונלי — מחק שורות שלא צריך
GMAIL_AFTER=2024/01/01        # רק מיילים אחרי תאריך זה
GMAIL_LABEL=חשבוניות          # רק מתיקיה/תווית ספציפית
GMAIL_QUERY=                  # שאילתה מותאמת אישית (מבטל את שאר הסינונים)
