{%- style -%}
.media-logos {
  padding: var(--space-3xl) 0;
  background: var(--bg-dark);
  border-bottom: 1px solid var(--border-glass);
}

.media-logos__label {
  text-align: center;
  font-size: var(--text-xs);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  color: var(--text-muted);
  margin-bottom: var(--space-xl);
}

.media-logos__grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: var(--space-3xl);
  max-width: var(--container-max);
  margin: 0 auto;
  padding: 0 var(--space-lg);
}

.media-logo {
  font-family: var(--font-heading);
  font-size: var(--text-xl);
  font-weight: 700;
  letter-spacing: 0.02em;
  color: var(--text-secondary);
  opacity: 0.55;
  transition: opacity var(--transition-base), color var(--transition-base);
  white-space: nowrap;
}

.media-logo:hover {
  opacity: 1;
  color: var(--text-primary);
}

@media (max-width: 768px) {
  .media-logos__grid {
    gap: var(--space-xl);
  }
  .media-logo {
    font-size: var(--text-lg);
  }
}
{%- endstyle -%}

<section class="media-logos">
  {%- if section.settings.label != blank -%}
    <div class="media-logos__label">{{ section.settings.label }}</div>
  {%- endif -%}
  <div class="media-logos__grid">
    {%- for block in section.blocks -%}
      <span class="media-logo" {{ block.shopify_attributes }}>
        {{ block.settings.name }}
      </span>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Media Logos",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section label",
      "default": "כתבו עלינו"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Media Outlet",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Outlet name",
          "default": "ynet"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Media Logos",
      "blocks": [
        { "type": "logo", "settings": { "name": "ynet" } },
        { "type": "logo", "settings": { "name": "כלכליסט" } },
        { "type": "logo", "settings": { "name": "Globes" } },
        { "type": "logo", "settings": { "name": "Walla" } },
        { "type": "logo", "settings": { "name": "Mako" } }
      ]
    }
  ]
}
{% endschema %}
