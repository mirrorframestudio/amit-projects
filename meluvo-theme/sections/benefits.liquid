      "label": "Title",
      "default": "למה Meluvo?"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "moon", "label": "Moon" },
            { "value": "eye", "label": "Eye" },
            { "value": "brain", "label": "Brain" },
            { "value": "zap", "label": "Energy" },
            { "value": "shield", "label": "Shield" },
            { "value": "heart", "label": "Heart" }
          ],
          "default": "moon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "שינה איכותית"
        },
        {
          "type": "textarea",
