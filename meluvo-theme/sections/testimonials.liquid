{%- style -%}
.testimonials {
  position: relative;
  overflow: hidden;
}

.testimonials__slider {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-xl);
}

.testimonial {
  padding: var(--space-2xl);
  display: flex;
  flex-direction: column;
  height: 100%;
}

.testimonial__rating {
  display: flex;
  gap: 3px;
  margin-bottom: var(--space-lg);
}

.testimonial__star {
  width: 18px;
  height: 18px;
  color: #fbbf24;
  fill: #fbbf24;
}

.testimonial__quote {
  font-size: var(--text-base);
  color: var(--text-secondary);
  line-height: 1.7;
  flex: 1;
  margin-bottom: var(--space-xl);
  position: relative;
}

.testimonial__quote::before {
  content: '"';
  position: absolute;
  top: -15px;
  right: -5px;
  font-size: 3rem;
  color: rgba(var(--color-primary-rgb), 0.15);
  font-family: Georgia, serif;
  line-height: 1;
}

.testimonial__author {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  padding-top: var(--space-lg);
  border-top: 1px solid var(--border-glass);
}

.testimonial__avatar {
  width: 44px;
  height: 44px;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: var(--text-sm);
  color: white;
  flex-shrink: 0;
}

.testimonial:nth-child(odd) .testimonial__avatar {
  background: linear-gradient(135deg, var(--color-primary), #4f46e5);
}

.testimonial:nth-child(even) .testimonial__avatar {
  background: linear-gradient(135deg, var(--color-secondary), #0891b2);
}

.testimonial__name {
  font-size: var(--text-sm);
  font-weight: 600;
}

.testimonial__location {
  font-size: var(--text-xs);
  color: var(--text-muted);
}

.testimonial__verified {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: var(--text-xs);
  color: var(--color-success);
  margin-top: 2px;
}

.testimonial__verified svg {
  width: 12px;
  height: 12px;
}

@media (max-width: 1024px) {
  .testimonials__slider {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 768px) {
  .testimonials__slider {
    grid-template-columns: 1fr;
  }
}
{%- endstyle -%}

<section class="section section--dark testimonials">
  <div class="glow-orb glow-orb--primary" style="width: 300px; height: 300px; bottom: -100px; right: 10%;"></div>

  <div class="container">
    <div class="section__header reveal">
      <span class="section__subtitle">{{ section.settings.subtitle }}</span>
      <h2 class="section__title">{{ section.settings.title }}</h2>
      <p class="section__description">{{ section.settings.description }}</p>
    </div>

    <div class="testimonials__slider stagger-children">
      {%- for block in section.blocks -%}
        <div class="testimonial glass-card" {{ block.shopify_attributes }}>
          <div class="testimonial__rating">
            {%- for i in (1..5) -%}
              <svg class="testimonial__star" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            {%- endfor -%}
          </div>

          <p class="testimonial__quote">{{ block.settings.quote }}</p>

          <div class="testimonial__author">
            <div class="testimonial__avatar">{{ block.settings.name | slice: 0, 2 }}</div>
            <div>
              <div class="testimonial__name">{{ block.settings.name }}</div>
              <div class="testimonial__location">{{ block.settings.location }}</div>
              <div class="testimonial__verified">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                קנייה מאומתת
              </div>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

