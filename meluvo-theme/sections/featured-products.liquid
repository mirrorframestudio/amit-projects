{%- style -%}
.featured-products {
  position: relative;
  overflow: hidden;
}

.featured-products__grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-2xl);
  max-width: 900px;
  margin: 0 auto;
}

.fp-card {
  position: relative;
  border-radius: var(--radius-2xl);
  overflow: hidden;
  background: var(--bg-glass);
  border: 1px solid var(--border-glass);
  backdrop-filter: blur(20px);
  transition: all var(--transition-slow);
  padding: var(--space-xl);
}

.fp-card:hover {
  border-color: var(--border-glass-hover);
  box-shadow: var(--shadow-glow-lg);
  transform: translateY(-8px);
}

.fp-card--night:hover {
  box-shadow: 0 0 40px rgba(var(--color-primary-rgb), 0.2);
}

.fp-card--day:hover {
  box-shadow: 0 0 40px rgba(var(--color-secondary-rgb), 0.2);
}

.fp-card__glow {
  position: absolute;
  top: -50%;
  right: -50%;
  width: 200%;
  height: 200%;
  border-radius: 50%;
  opacity: 0;
  transition: opacity var(--transition-slow);
  pointer-events: none;
}

.fp-card--night .fp-card__glow {
  background: radial-gradient(circle, rgba(var(--color-primary-rgb), 0.06) 0%, transparent 60%);
}

.fp-card--day .fp-card__glow {
  background: radial-gradient(circle, rgba(var(--color-secondary-rgb), 0.06) 0%, transparent 60%);
}

.fp-card:hover .fp-card__glow {
  opacity: 1;
}

.fp-card__badge {
  display: inline-flex;
  align-items: center;
  gap: var(--space-xs);
  padding: 0.375rem 0.875rem;
  border-radius: var(--radius-full);
  font-size: var(--text-xs);
  font-weight: 600;
  margin-bottom: var(--space-lg);
}

.fp-card--night .fp-card__badge {
  background: rgba(var(--color-primary-rgb), 0.15);
  color: var(--color-glow);
  border: 1px solid rgba(var(--color-primary-rgb), 0.2);
}

.fp-card--day .fp-card__badge {
  background: rgba(var(--color-secondary-rgb), 0.15);
  color: var(--color-secondary);
  border: 1px solid rgba(var(--color-secondary-rgb), 0.2);
}

.fp-card__media {
  position: relative;
  aspect-ratio: 1;
  border-radius: var(--radius-xl);
  overflow: hidden;
  margin-bottom: var(--space-xl);
  background: linear-gradient(135deg, var(--bg-dark-secondary), var(--bg-dark-tertiary));
}

.fp-card__media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s ease;
}

.fp-card:hover .fp-card__media img {
  transform: scale(1.05);
}

.fp-card__title {
  font-size: var(--text-2xl);
  font-weight: 700;
  margin-bottom: var(--space-sm);
}

.fp-card__description {
  font-size: var(--text-sm);
  color: var(--text-secondary);
  margin-bottom: var(--space-lg);
  line-height: 1.6;
}

.fp-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-md);
}

.fp-card__price {
  display: flex;
  align-items: baseline;
  gap: var(--space-sm);
  direction: ltr;
}

.fp-card__price-current {
  font-size: var(--text-2xl);
  font-weight: 700;
}

.fp-card__price-compare {
  font-size: var(--text-sm);
  color: var(--text-muted);
  text-decoration: line-through;
}

.fp-card__cta {
  padding: 0.75rem 1.5rem;
  font-size: var(--text-sm);
}

.fp-card--night .fp-card__cta {
  background: var(--color-primary);
  color: var(--text-dark);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-glow);
}

.fp-card--day .fp-card__cta {
  background: var(--color-secondary);
  color: var(--text-dark);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-glow-cyan);
}

@media (max-width: 768px) {
  .featured-products__grid {
    grid-template-columns: 1fr;
    max-width: 420px;
  }
}
{%- endstyle -%}

<section class="section section--dark featured-products">
  <div class="glow-orb glow-orb--primary" style="width: 400px; height: 400px; top: -100px; right: -100px;"></div>
  <div class="glow-orb glow-orb--secondary" style="width: 300px; height: 300px; bottom: -50px; left: -50px;"></div>

  <div class="container">
    <div class="section__header reveal">
      <span class="section__subtitle">{{ section.settings.subtitle }}</span>
      <h2 class="section__title">{{ section.settings.title }}</h2>
      <p class="section__description">{{ section.settings.description }}</p>
    </div>

    <div class="featured-products__grid stagger-children">
      {%- for block in section.blocks -%}
        {%- assign product = block.settings.product -%}
        {%- if product != blank -%}
          <div class="fp-card fp-card--{{ block.settings.card_style }} glass-card--static reveal" {{ block.shopify_attributes }}>
            <div class="fp-card__glow"></div>

            <span class="fp-card__badge">
              {%- if block.settings.card_style == 'night' -%}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
              {%- else -%}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
              {%- endif -%}
              {{ block.settings.badge_text }}
            </span>

            <a href="{{ product.url }}" class="fp-card__media product-image-hover">
              <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" width="600" height="600" loading="lazy">
            </a>

            <h3 class="fp-card__title">{{ block.settings.custom_title | default: product.title }}</h3>
            <p class="fp-card__description">{{ block.settings.custom_description }}</p>

            <div class="fp-card__footer">
              <div class="fp-card__price">
                <span class="fp-card__price-current">{{ product.price | money }}</span>
                {%- if product.compare_at_price > product.price -%}
                  <span class="fp-card__price-compare">{{ product.compare_at_price | money }}</span>
                {%- endif -%}
              </div>
              <a href="{{ product.url }}" class="btn fp-card__cta">לרכישה</a>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Products",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "המוצרים שלנו"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "בחר את המשקפיים שלך"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "משקפי יום לעבודה מול מסך ומשקפי לילה לשינה טובה יותר"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "select",
          "id": "card_style",
          "label": "Card style",
          "options": [
            { "value": "night", "label": "Night (Purple)" },
            { "value": "day", "label": "Day (Cyan)" }
          ],
          "default": "night"
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge text",
          "default": "משקפי לילה"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom title (optional)"
        },
        {
          "type": "textarea",
          "id": "custom_description",
          "label": "Short description",
          "default": "חוסמים 97% מהאור הכחול. מושלמים לשימוש בערב לפני השינה."
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Featured Products",
      "blocks": [
        {
          "type": "product",
          "settings": {
            "card_style": "night",
            "badge_text": "משקפי לילה",
            "custom_description": "חוסמים 97% מהאור הכחול. מושלמים לשימוש בערב לפני השינה."
          }
        },
        {
          "type": "product",
          "settings": {
            "card_style": "day",
            "badge_text": "משקפי יום",
            "custom_description": "הגנה אופטימלית מול מסכים. לריכוז חד יותר ופחות עומס על העיניים."
          }
        }
      ]
    }
  ]
}
{% endschema %}
