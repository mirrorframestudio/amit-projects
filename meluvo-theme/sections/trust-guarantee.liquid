{%- style -%}
.trust-section {
  position: relative;
  overflow: hidden;
}

.trust-section__inner {
  padding: var(--space-4xl);
  border-radius: var(--radius-2xl);
  position: relative;
  overflow: hidden;
}

.trust-section__bg {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(var(--color-primary-rgb), 0.05), rgba(var(--color-secondary-rgb), 0.05));
}

.trust-section__bg-pattern {
  position: absolute;
  inset: 0;
  background-image: radial-gradient(circle at 2px 2px, rgba(255,255,255,0.03) 1px, transparent 0);
  background-size: 40px 40px;
}

.trust-section__content {
  position: relative;
  z-index: 1;
}

.trust-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-2xl);
  margin-top: var(--space-3xl);
}

.trust-block {
  text-align: center;
  padding: var(--space-xl);
}

.trust-block__icon {
  width: 64px;
  height: 64px;
  margin: 0 auto var(--space-lg);
  border-radius: var(--radius-xl);
  display: flex;
  align-items: center;
  justify-content: center;
}

.trust-block:nth-child(1) .trust-block__icon {
  background: rgba(var(--color-primary-rgb), 0.1);
  color: var(--color-primary);
}

.trust-block:nth-child(2) .trust-block__icon {
  background: rgba(16, 185, 129, 0.1);
  color: var(--color-success);
}

.trust-block:nth-child(3) .trust-block__icon {
  background: rgba(var(--color-secondary-rgb), 0.1);
  color: var(--color-secondary);
}

.trust-block__icon svg {
  width: 28px;
  height: 28px;
}

.trust-block__title {
  font-size: var(--text-lg);
  font-weight: 600;
  margin-bottom: var(--space-sm);
}

.trust-block__text {
  font-size: var(--text-sm);
  color: var(--text-secondary);
  line-height: 1.6;
}

@media (max-width: 768px) {
  .trust-grid { grid-template-columns: 1fr; }
  .trust-section__inner { padding: var(--space-2xl); }
}
{%- endstyle -%}

<section class="section section--darker trust-section">
  <div class="container">
    <div class="trust-section__inner glass-card--static reveal">
      <div class="trust-section__bg"></div>
      <div class="trust-section__bg-pattern"></div>

      <div class="trust-section__content">
        <div class="section__header" style="margin-bottom: 0;">
          <span class="section__subtitle">{{ section.settings.subtitle }}</span>
          <h2 class="section__title">{{ section.settings.title }}</h2>
          <p class="section__description">{{ section.settings.description }}</p>
        </div>

        <div class="trust-grid stagger-children">
          {%- for block in section.blocks -%}
            <div class="trust-block" {{ block.shopify_attributes }}>
              <div class="trust-block__icon">
                {%- case block.settings.icon -%}
                  {%- when 'refund' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
                  {%- when 'shipping' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                  {%- when 'secure' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                  {%- when 'quality' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                {%- endcase -%}
              </div>
              <h3 class="trust-block__title">{{ block.settings.title }}</h3>
              <p class="trust-block__text">{{ block.settings.text }}</p>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trust & Guarantee",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "קנייה בטוחה"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "אנחנו עומדים מאחורי המוצר שלנו"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "קנייה ללא סיכון עם ערבויות מלאות"
    }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "refund", "label": "Refund" },
            { "value": "shipping", "label": "Shipping" },
            { "value": "secure", "label": "Secure" },
            { "value": "quality", "label": "Quality" }
          ],
          "default": "refund"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Trust & Guarantee",
      "blocks": [
        {
          "type": "trust_item",
          "settings": {
            "icon": "refund",
            "title": "30 ימי ניסיון",
            "text": "לא מרוצה? החזר את המשקפיים תוך 30 יום וקבל החזר כספי מלא. בלי שאלות."
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "icon": "shipping",
            "title": "משלוח חינם",
            "text": "משלוח חינם לכל רחבי הארץ. לנקודת איסוף או עד הבית שלך."
          }
        },
        {
          "type": "trust_item",
          "settings": {
            "icon": "secure",
            "title": "תשלום מאובטח",
            "text": "כל התשלומים מאובטחים ומוצפנים. אנחנו תומכים בכל כרטיסי האשראי ואפל פיי."
          }
        }
      ]
    }
  ]
}
{% endschema %}
