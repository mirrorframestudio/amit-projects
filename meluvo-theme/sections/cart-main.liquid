{%- style -%}
.cart-page {
  padding-top: var(--space-3xl);
  min-height: 60vh;
}

.cart-page__title {
  font-size: var(--text-3xl);
  font-weight: 700;
  margin-bottom: var(--space-2xl);
  text-align: center;
}

.cart-page__layout {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: var(--space-3xl);
  align-items: flex-start;
}

.cart-page__items {
  display: flex;
  flex-direction: column;
}

.cart-page-item {
  display: flex;
  gap: var(--space-lg);
  padding: var(--space-lg) 0;
  border-bottom: 1px solid var(--border-glass);
}

.cart-page-item__image {
  width: 120px;
  height: 120px;
  border-radius: var(--radius-lg);
  overflow: hidden;
  flex-shrink: 0;
  background: var(--bg-glass);
}

.cart-page-item__image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.cart-page-item__details {
  flex: 1;
}

.cart-page-item__title {
  font-size: var(--text-base);
  font-weight: 600;
  margin-bottom: var(--space-xs);
}

.cart-page-item__variant {
  font-size: var(--text-sm);
  color: var(--text-muted);
  margin-bottom: var(--space-md);
}

.cart-page-item__bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cart-page-item__price {
  font-size: var(--text-lg);
  font-weight: 600;
}

.cart-summary {
  padding: var(--space-2xl);
  border-radius: var(--radius-xl);
  position: sticky;
  top: calc(var(--header-height) + var(--space-xl));
}

.cart-summary__title {
  font-size: var(--text-xl);
  font-weight: 600;
  margin-bottom: var(--space-xl);
  padding-bottom: var(--space-lg);
  border-bottom: 1px solid var(--border-glass);
}

.cart-summary__row {
  display: flex;
  justify-content: space-between;
  font-size: var(--text-sm);
  color: var(--text-secondary);
  margin-bottom: var(--space-md);
}

.cart-summary__total {
  display: flex;
  justify-content: space-between;
  font-size: var(--text-xl);
  font-weight: 700;
  padding-top: var(--space-lg);
  border-top: 1px solid var(--border-glass);
  margin-top: var(--space-lg);
  margin-bottom: var(--space-xl);
}

.cart-summary__note {
  font-size: var(--text-xs);
  color: var(--text-muted);
  text-align: center;
  margin-top: var(--space-md);
}

.cart-empty {
  text-align: center;
  padding: var(--space-5xl) var(--space-xl);
}

.cart-empty svg {
  width: 56px;
  height: 56px;
  color: var(--text-muted);
  margin-bottom: var(--space-xl);
}

.cart-empty h2 {
  font-size: var(--text-2xl);
  margin-bottom: var(--space-md);
}

.cart-empty p {
  margin-bottom: var(--space-xl);
}

@media (max-width: 768px) {
  .cart-page__layout { grid-template-columns: 1fr; }
  .cart-summary { position: static; }
  .cart-page-item__image { width: 80px; height: 80px; }
}
{%- endstyle -%}

<section class="section section--dark cart-page">
  <div class="container">
    {%- if cart.item_count > 0 -%}
      <h1 class="cart-page__title">{{ 'cart.title' | t }} ({{ cart.item_count }})</h1>

      <div class="cart-page__layout">
        <div class="cart-page__items">
          {%- for item in cart.items -%}
            <div class="cart-page-item">
              <a href="{{ item.url }}" class="cart-page-item__image">
                {%- if item.image -%}
                  <img src="{{ item.image | image_url: width: 240 }}" alt="{{ item.title | escape }}" width="120" height="120" loading="lazy">
                {%- endif -%}
              </a>
              <div class="cart-page-item__details">
                <a href="{{ item.url }}" class="cart-page-item__title">{{ item.product.title }}</a>
                {%- unless item.variant.title == 'Default Title' -%}
                  <div class="cart-page-item__variant">{{ item.variant.title }}</div>
                {%- endunless -%}
                <div class="cart-page-item__bottom">
                  <div class="quantity-selector">
                    <button class="quantity-selector__btn" data-qty-decrease>−</button>
                    <input type="number" class="quantity-selector__input" value="{{ item.quantity }}" min="1">
                    <button class="quantity-selector__btn" data-qty-increase>+</button>
                  </div>
                  <span class="cart-page-item__price">{{ item.final_line_price | money }}</span>
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>

        <div class="cart-summary glass-card--static">
          <h2 class="cart-summary__title">סיכום הזמנה</h2>
          <div class="cart-summary__row">
            <span>{{ 'cart.subtotal' | t }}</span>
            <span>{{ cart.total_price | money }}</span>
          </div>
          <div class="cart-summary__row">
            <span>משלוח</span>
            <span style="color: var(--color-success);">חינם</span>
          </div>
          <div class="cart-summary__total">
            <span>סה"כ</span>
            <span>{{ cart.total_price | money }}</span>
          </div>
          <a href="/checkout" class="btn btn--primary btn--full btn--large">{{ 'cart.checkout' | t }}</a>
          <p class="cart-summary__note">משלוח חינם לכל רחבי הארץ</p>
        </div>
      </div>
    {%- else -%}
      <div class="cart-empty">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        <h2>העגלה שלך ריקה</h2>
        <p class="section__description">עדיין לא הוספת מוצרים לעגלה</p>
        <a href="/collections/all" class="btn btn--primary btn--large">לקטלוג המוצרים</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Cart Page",
  "tag": "section",
  "settings": []
}
{% endschema %}
