{%- style -%}
.stats {
  position: relative;
  overflow: hidden;
}

.stats__bg-line {
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(to left, transparent, var(--border-glass), transparent);
}

.stats__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-xl);
  position: relative;
  z-index: 1;
}

.stat-block {
  text-align: center;
  padding: var(--space-3xl) var(--space-xl);
  position: relative;
}

.stat-block::after {
  content: '';
  position: absolute;
  left: 0;
  top: 20%;
  bottom: 20%;
  width: 1px;
  background: linear-gradient(to bottom, transparent, var(--border-glass), transparent);
}

.stat-block:last-child::after {
  display: none;
}

.stat-block__number {
  font-size: clamp(2.5rem, 5vw, 4rem);
  font-weight: 800;
  line-height: 1;
  margin-bottom: var(--space-sm);
  position: relative;
  display: inline-block;
}

.stat-block:nth-child(1) .stat-block__number { color: var(--color-primary); }
.stat-block:nth-child(2) .stat-block__number { color: var(--color-secondary); }
.stat-block:nth-child(3) .stat-block__number { color: var(--color-success); }

.stat-block__number-glow {
  position: absolute;
  inset: -10px;
  border-radius: 50%;
  filter: blur(20px);
  opacity: 0.2;
}

.stat-block:nth-child(1) .stat-block__number-glow { background: var(--color-primary); }
.stat-block:nth-child(2) .stat-block__number-glow { background: var(--color-secondary); }
.stat-block:nth-child(3) .stat-block__number-glow { background: var(--color-success); }

.stat-block__label {
  font-size: var(--text-base);
  color: var(--text-secondary);
  max-width: 250px;
  margin: 0 auto;
  line-height: 1.5;
}

@media (max-width: 768px) {
  .stats__grid {
    grid-template-columns: 1fr;
    gap: 0;
  }
  .stat-block::after {
    top: auto;
    bottom: 0;
    left: 20%;
    right: 20%;
    width: auto;
    height: 1px;
    background: linear-gradient(to left, transparent, var(--border-glass), transparent);
  }
  .stat-block { padding: var(--space-2xl) var(--space-md); }
}
{%- endstyle -%}

<section class="section section--dark stats">
  <div class="stats__bg-line"></div>
  <div class="container">
    <div class="section__header reveal">
      <span class="section__subtitle">{{ section.settings.subtitle }}</span>
      <h2 class="section__title">{{ section.settings.title }}</h2>
    </div>

    <div class="stats__grid glass-card--static stagger-children" style="border-radius: var(--radius-2xl); overflow: hidden;">
      {%- for block in section.blocks -%}
        <div class="stat-block" {{ block.shopify_attributes }}>
          <div class="stat-block__number" data-count-target="{{ block.settings.number }}">
            <div class="stat-block__number-glow"></div>
            {{ block.settings.number }}{{ block.settings.suffix }}
          </div>
          <p class="stat-block__label">{{ block.settings.label }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Statistics",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
