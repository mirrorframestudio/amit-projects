{%- style -%}
.product-main {
  position: relative;
  overflow: hidden;
  padding-top: var(--space-3xl);
}

.product-main__grid {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: var(--space-4xl);
  align-items: flex-start;
}

/* --- Gallery --- */
.product-gallery {
  position: sticky;
  top: calc(var(--header-height) + var(--space-xl));
}

.product-gallery__main {
  position: relative;
  border-radius: var(--radius-2xl);
  overflow: hidden;
  background: var(--bg-glass);
  border: 1px solid var(--border-glass);
  aspect-ratio: 1;
  margin-bottom: var(--space-md);
}

.product-gallery__main img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: opacity var(--transition-base);
}

.product-gallery__sale-badge {
  position: absolute;
  top: var(--space-lg);
  right: var(--space-lg);
  z-index: 2;
}

.product-gallery__thumbnails {
  display: flex;
  gap: var(--space-sm);
  overflow-x: auto;
  padding-bottom: var(--space-sm);
  scrollbar-width: thin;
  scrollbar-color: var(--border-glass) transparent;
}

.product-gallery__thumb {
  width: 72px;
  height: 72px;
  flex-shrink: 0;
  border-radius: var(--radius-md);
  overflow: hidden;
  border: 2px solid transparent;
  cursor: pointer;
  transition: border-color var(--transition-fast);
  background: var(--bg-glass);
}

.product-gallery__thumb.active,
.product-gallery__thumb:hover {
  border-color: var(--color-primary);
}

.product-gallery__thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* --- Product Info --- */
.product-info {
  position: relative;
}

.product-info__breadcrumb {
  display: flex;
  align-items: center;
  gap: var(--space-sm);
  font-size: var(--text-xs);
  color: var(--text-muted);
  margin-bottom: var(--space-lg);
}

.product-info__breadcrumb a {
  transition: color var(--transition-fast);
}

.product-info__breadcrumb a:hover {
  color: var(--color-primary);
}

.product-info__title {
  font-size: var(--text-3xl);
  font-weight: 700;
  margin-bottom: var(--space-md);
}

.product-info__price-row {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  margin-bottom: var(--space-xl);
}

.product-info__price {
  font-size: var(--text-3xl);
  font-weight: 800;
  direction: ltr;
}

.product-info__compare-price {
  font-size: var(--text-lg);
  color: var(--text-muted);
  text-decoration: line-through;
  direction: ltr;
}

.product-info__save-badge {
  padding: 0.25rem 0.75rem;
  border-radius: var(--radius-full);
  background: rgba(200, 113, 105, 0.15);
  color: #d98a82;
  font-size: var(--text-xs);
  font-weight: 600;
  border: 1px solid rgba(200, 113, 105, 0.25);
}

.product-info__short-desc {
  font-size: var(--text-base);
  color: var(--text-secondary);
  line-height: 1.7;
  margin-bottom: var(--space-xl);
  padding-bottom: var(--space-xl);
  border-bottom: 1px solid var(--border-glass);
}

/* Variants */
.product-info__variants {
  margin-bottom: var(--space-xl);
}

.product-info__variant-label {
  font-size: var(--text-sm);
  font-weight: 600;
  margin-bottom: var(--space-sm);
}

.product-info__variant-options {
  display: flex;
  gap: var(--space-sm);
  flex-wrap: wrap;
}

.variant-option {
  padding: 0.625rem 1.25rem;
  border-radius: var(--radius-lg);
  border: 1px solid var(--border-glass);
  background: var(--bg-glass);
  font-size: var(--text-sm);
  font-weight: 500;
  transition: all var(--transition-fast);
  cursor: pointer;
}

.variant-option:hover {
  border-color: var(--border-glass-hover);
}

.variant-option.selected {
  border-color: var(--color-primary);
  background: rgba(var(--color-primary-rgb), 0.1);
  color: var(--color-glow);
}

/* Quantity & ATC */
.product-info__actions {
  display: flex;
  gap: var(--space-md);
  margin-bottom: var(--space-xl);
}

.quantity-selector {
  display: flex;
  align-items: center;
  border: 1px solid var(--border-glass);
  border-radius: var(--radius-lg);
  background: var(--bg-glass);
  overflow: hidden;
}

.quantity-selector__btn {
  width: 44px;
  height: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--text-lg);
  color: var(--text-secondary);
  transition: all var(--transition-fast);
}

.quantity-selector__btn:hover {
  color: var(--text-primary);
  background: var(--bg-glass-hover);
}

.quantity-selector__input {
  width: 48px;
  text-align: center;
  border: none;
  background: none;
  color: var(--text-primary);
  font-size: var(--text-base);
  font-weight: 600;
  font-family: inherit;
  -moz-appearance: textfield;
}

.quantity-selector__input::-webkit-outer-spin-button,
.quantity-selector__input::-webkit-inner-spin-button {
  -webkit-appearance: none;
  margin: 0;
}

.product-info__atc-btn {
  flex: 1;
  height: 48px;
  font-size: var(--text-base);
}

/* Trust badges */
.product-info__trust {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
  padding: var(--space-lg);
  border-radius: var(--radius-xl);
  background: var(--bg-glass);
  border: 1px solid var(--border-glass);
  margin-bottom: var(--space-xl);
}

.product-trust-item {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  font-size: var(--text-sm);
  color: var(--text-secondary);
}

.product-trust-item svg {
  width: 20px;
  height: 20px;
  flex-shrink: 0;
  color: var(--color-success);
}

/* Accordion */
.product-accordion {
  border-top: 1px solid var(--border-glass);
}

.product-accordion__item {
  border-bottom: 1px solid var(--border-glass);
}

.product-accordion__trigger {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: var(--space-lg) 0;
  font-size: var(--text-base);
  font-weight: 600;
  color: var(--text-primary);
  text-align: right;
  cursor: pointer;
  transition: color var(--transition-fast);
}

.product-accordion__trigger:hover {
  color: var(--color-primary);
}

.product-accordion__trigger-icon {
  width: 20px;
  height: 20px;
  flex-shrink: 0;
  color: var(--text-muted);
  transition: transform var(--transition-base);
}

.product-accordion__item.is-open .product-accordion__trigger-icon {
  transform: rotate(180deg);
}

.product-accordion__content {
  max-height: 0;
  overflow: hidden;
  transition: max-height var(--transition-slow);
}

.product-accordion__item.is-open .product-accordion__content {
  max-height: 500px;
}

.product-accordion__body {
  padding-bottom: var(--space-lg);
  font-size: var(--text-sm);
  color: var(--text-secondary);
  line-height: 1.7;
}

/* --- Mobile Sticky ATC --- */
.mobile-sticky-atc {
  display: none;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 90;
  padding: var(--space-md) var(--space-lg);
  background: rgba(13, 27, 42, 0.95);
  backdrop-filter: blur(20px);
  border-top: 1px solid var(--border-glass);
}

.mobile-sticky-atc__inner {
  display: flex;
  align-items: center;
  gap: var(--space-md);
  max-width: var(--container-max);
  margin: 0 auto;
}

.mobile-sticky-atc__price {
  font-size: var(--text-lg);
  font-weight: 700;
  white-space: nowrap;
  direction: ltr;
}

.mobile-sticky-atc__btn {
  flex: 1;
  height: 44px;
}

@media (max-width: 1024px) {
  .product-main__grid {
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
  }
  .product-gallery { position: static; }
}

@media (max-width: 768px) {
  .mobile-sticky-atc { display: block; }
  .product-main { padding-bottom: 80px; }
}
{%- endstyle -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}

<section class="section section--dark product-main">
  <div class="container">
    <div class="product-main__grid">
      <!-- Gallery -->
      <div class="product-gallery" data-product-gallery>
        <div class="product-gallery__main">
          {%- if current_variant.compare_at_price > current_variant.price -%}
            {%- assign save_percent = current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price -%}
            <span class="badge badge--sale product-gallery__sale-badge">{{ save_percent }}% הנחה</span>
          {%- endif -%}
          <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.featured_image.alt | escape }}" width="800" height="800" id="product-main-image" loading="eager" fetchpriority="high">
        </div>

        {%- if product.images.size > 1 -%}
          <div class="product-gallery__thumbnails">
            {%- for image in product.images -%}
              <button class="product-gallery__thumb {% if forloop.first %}active{% endif %}" data-thumb data-image-url="{{ image | image_url: width: 800 }}" aria-label="תמונה {{ forloop.index }}">
                <img src="{{ image | image_url: width: 150 }}" alt="{{ image.alt | escape }}" width="72" height="72" loading="lazy">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <!-- Product Info -->
      <div class="product-info">
        <nav class="product-info__breadcrumb" aria-label="ניווט">
          <a href="/">דף הבית</a>
          <span>/</span>
          {%- if product.collections.size > 0 -%}
            <a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
            <span>/</span>
          {%- endif -%}
          <span>{{ product.title }}</span>
        </nav>

        <h1 class="product-info__title">{{ product.title }}</h1>

        <div class="product-info__price-row">
          <span class="product-info__price">{{ current_variant.price | money }}</span>
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <span class="product-info__compare-price">{{ current_variant.compare_at_price | money }}</span>
            <span class="product-info__save-badge">חסכו {{ save_percent }}%</span>
          {%- endif -%}
        </div>

        {%- if section.settings.short_description != blank -%}
          <p class="product-info__short-desc">{{ section.settings.short_description }}</p>
        {%- elsif product.description != blank -%}
          <p class="product-info__short-desc">{{ product.description | strip_html | truncatewords: 30 }}</p>
        {%- endif -%}

        <!-- Variant Selector -->
        {%- unless product.has_only_default_variant -%}
          <form action="/cart/add" method="post" data-product-form>
            <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

            {%- for option in product.options_with_values -%}
              <div class="product-info__variants">
                <label class="product-info__variant-label">{{ option.name }}:</label>
                <div class="product-info__variant-options">
                  {%- for value in option.values -%}
                    <button type="button" class="variant-option {% if option.selected_value == value %}selected{% endif %}" data-variant-option="{{ value }}">
                      {{ value }}
                    </button>
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}

            <div class="product-info__actions">
              <div class="quantity-selector">
                <button type="button" class="quantity-selector__btn" data-qty-decrease aria-label="הפחת כמות">−</button>
                <input type="number" name="quantity" class="quantity-selector__input" value="1" min="1" data-qty-input aria-label="כמות">
                <button type="button" class="quantity-selector__btn" data-qty-increase aria-label="הוסף כמות">+</button>
              </div>
              <button type="submit" class="btn btn--primary product-info__atc-btn" {% unless current_variant.available %}disabled{% endunless %}>
                {%- if current_variant.available -%}
                  {{ 'products.add_to_cart' | t }}
                {%- else -%}
                  {{ 'products.sold_out' | t }}
                {%- endif -%}
              </button>
            </div>
          </form>
        {%- else -%}
          <form action="/cart/add" method="post" data-product-form>
            <input type="hidden" name="id" value="{{ current_variant.id }}">
            <div class="product-info__actions">
              <div class="quantity-selector">
                <button type="button" class="quantity-selector__btn" data-qty-decrease aria-label="הפחת כמות">−</button>
                <input type="number" name="quantity" class="quantity-selector__input" value="1" min="1" data-qty-input aria-label="כמות">
                <button type="button" class="quantity-selector__btn" data-qty-increase aria-label="הוסף כמות">+</button>
              </div>
              <button type="submit" class="btn btn--primary product-info__atc-btn" {% unless current_variant.available %}disabled{% endunless %}>
                {%- if current_variant.available -%}
                  {{ 'products.add_to_cart' | t }}
                {%- else -%}
                  {{ 'products.sold_out' | t }}
                {%- endif -%}
              </button>
            </div>
          </form>
        {%- endunless -%}

        <!-- Trust Badges -->
        <div class="product-info__trust">
          <div class="product-trust-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <span>30 ימי ניסיון — החזר כספי מלא</span>
          </div>
          <div class="product-trust-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
            <span>משלוח חינם לכל רחבי הארץ</span>
          </div>
          <div class="product-trust-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            <span>חסימת עד 97% מהאור הכחול</span>
          </div>
        </div>

        <!-- Product Accordion -->
        <div class="product-accordion">
          {%- for block in section.blocks -%}
            {%- if block.type == 'accordion' -%}
              <div class="product-accordion__item" data-accordion-item {{ block.shopify_attributes }}>
                <button class="product-accordion__trigger" data-accordion-trigger aria-expanded="false">
                  <span>{{ block.settings.title }}</span>
                  <svg class="product-accordion__trigger-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                </button>
                <div class="product-accordion__content" aria-hidden="true">
                  <div class="product-accordion__body">
                    {{ block.settings.content }}
                  </div>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}

          {%- if product.description != blank -%}
            <div class="product-accordion__item" data-accordion-item>
              <button class="product-accordion__trigger" data-accordion-trigger aria-expanded="false">
                <span>תיאור מלא</span>
                <svg class="product-accordion__trigger-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
              </button>
              <div class="product-accordion__content" aria-hidden="true">
                <div class="product-accordion__body">
                  {{ product.description }}
                </div>
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Mobile Sticky ATC -->
<div class="mobile-sticky-atc" data-mobile-sticky-atc>
  <div class="mobile-sticky-atc__inner">
    <span class="mobile-sticky-atc__price">{{ current_variant.price | money }}</span>
    <button class="btn btn--primary mobile-sticky-atc__btn" data-mobile-atc-btn {% unless current_variant.available %}disabled{% endunless %}>
      {%- if current_variant.available -%}
        {{ 'products.add_to_cart' | t }}
      {%- else -%}
        {{ 'products.sold_out' | t }}
      {%- endif -%}
    </button>
  </div>
</div>

{% schema %}
{
  "name": "Product Main",
  "tag": "section",
  "settings": [
    {
      "type": "textarea",
      "id": "short_description",
      "label": "Short description (override)"
    }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Accordion tab",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "למי מתאימים המשקפיים?"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Main",
      "blocks": [
        {
          "type": "accordion",
          "settings": {
            "title": "למי מתאימים המשקפיים?",
            "content": "<p>לכל מי שמבלה זמן מול מסכים — עובדים מרחוק, סטודנטים, גיימרים, ספורטאים, וכל מי שרוצה לשפר את איכות השינה.</p>"
          }
        },
        {
          "type": "accordion",
          "settings": {
            "title": "מה אם אני לא מרוצה?",
            "content": "<p>יש לנו מדיניות של 30 ימי ניסיון. אם אתם לא מרוצים מכל סיבה שהיא, תוכלו להחזיר ולקבל החזר כספי מלא.</p>"
          }
        },
        {
          "type": "accordion",
          "settings": {
            "title": "כמה זמן לוקח המשלוח?",
            "content": "<p>7-14 ימי עסקים לנקודת איסוף או עד הבית. משלוח חינם לכל רחבי הארץ!</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
