<div class="cart-drawer" data-cart-drawer aria-hidden="true">
  <div class="cart-drawer__overlay" data-cart-drawer-close></div>
  <div class="cart-drawer__panel">
    <div class="cart-drawer__header">
      <h2 class="cart-drawer__title">{{ 'cart.title' | t }}</h2>
      <button class="cart-drawer__close" aria-label="{{ 'general.close' | t }}" data-cart-drawer-close>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>

    <div class="cart-drawer__body" data-cart-body>
      {%- if cart.item_count == 0 -%}
        <div class="cart-drawer__empty">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
          <p>{{ 'cart.empty' | t }}</p>
          <a href="/collections/all" class="btn btn--primary" style="margin-top: var(--space-lg);">{{ 'cart.continue_shopping' | t }}</a>
        </div>
      {%- else -%}
        {%- for item in cart.items -%}
          <div class="cart-item" data-cart-item="{{ item.key }}">
            <div class="cart-item__image">
              {%- if item.image -%}
                <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title | escape }}" width="80" height="80" loading="lazy">
              {%- endif -%}
            </div>
            <div class="cart-item__details">
              <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
              {%- unless item.variant.title == 'Default Title' -%}
                <div class="cart-item__variant">{{ item.variant.title }}</div>
              {%- endunless -%}
              <div class="cart-item__quantity">
                <button class="cart-item__qty-btn" data-qty-minus aria-label="הפחת כמות">−</button>
                <span class="cart-item__qty-value">{{ item.quantity }}</span>
                <button class="cart-item__qty-btn" data-qty-plus aria-label="הוסף כמות">+</button>
              </div>
              <div class="cart-item__price">{{ item.final_line_price | money }}</div>
            </div>
            <button class="cart-item__remove" data-remove-item aria-label="{{ 'cart.remove' | t }}">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
            </button>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if cart.item_count > 0 -%}
      <div class="cart-drawer__footer">
        <div class="cart-drawer__subtotal">
          <span>{{ 'cart.subtotal' | t }}</span>
          <span data-cart-subtotal>{{ cart.total_price | money }}</span>
        </div>
        <p class="cart-drawer__shipping-note">משלוח חינם לכל רחבי הארץ</p>
        <a href="/checkout" class="btn btn--primary btn--full btn--large">{{ 'cart.checkout' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</div>
